on boot
    chown system system /sys/panel_feature/hbm_mode
    chmod 0664 /sys/panel_feature/hbm_mode
    chown system system /sys/devices/platform/mtk-leds/leds/lcd-backlight/brightness
    chmod 0664 /sys/devices/platform/mtk-leds/leds/lcd-backlight/brightness

service udfps_hbm /system/bin/sh /system/bin/udfps_hbm.sh
    class late_start
    user root
    group root
    disabled
    oneshot

# Start when UDFPS is engaged (tie to a property toggled by your fingerprint HAL)
on property:sys.fingerprint.udfps=1
    start udfps_hbm

# Optionally restore after unlock
on property:sys.fingerprint.udfps=0
    exec u:r:init:s0 root root -- /system/bin/sh -c 'echo 0 > /sys/panel_feature/hbm_mode'
